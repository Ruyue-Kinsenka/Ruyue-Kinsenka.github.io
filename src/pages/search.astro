---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="搜索 · Ruyue" description="按标题、分类、标签和摘要全文检索文章">
  <section class="search-panel">
    <h1 class="page-title">搜索文章</h1>
    <p class="page-subtitle">支持标题、分类、标签和摘要关键词搜索。</p>

    <label for="search-input" class="muted">输入关键词</label>
    <input id="search-input" class="search-input" type="search" placeholder="例如：设计、诗性、Astro" />

    <div id="search-count" class="muted" style="margin-top: 0.7rem;"></div>
    <div id="search-results" class="search-results"></div>
  </section>

  <script is:inline>
    const input = document.getElementById("search-input");
    const resultsNode = document.getElementById("search-results");
    const countNode = document.getElementById("search-count");

    let data = [];

    const normalize = (text) => text.toLowerCase().trim();

    const render = (items, keyword) => {
      if (!resultsNode || !countNode) return;

      if (!keyword) {
        countNode.textContent = "请输入关键词开始搜索。";
        resultsNode.innerHTML = "";
        return;
      }

      countNode.textContent = `找到 ${items.length} 条结果`;

      if (items.length === 0) {
        resultsNode.innerHTML = "<article class=\"search-item muted\">未找到相关文章，试试更短或更通用的关键词。</article>";
        return;
      }

      resultsNode.innerHTML = items
        .map(
          (item) => `
            <article class="search-item">
              <a href="${item.url}"><strong>${item.title}</strong></a>
              <p class="muted">${item.description}</p>
              <div class="meta-inline">分类：${item.category} · 标签：${item.tags.map((tag) => `#${tag}`).join(" ")}</div>
            </article>
          `
        )
        .join("");
    };

    const handleSearch = () => {
      const keyword = normalize(input?.value ?? "");

      if (!keyword) {
        render([], "");
        return;
      }

      const filtered = data.filter((item) => {
        const stack = [item.title, item.description, item.category, item.tags.join(" "), item.content]
          .join(" ")
          .toLowerCase();
        return stack.includes(keyword);
      });

      render(filtered, keyword);
    };

    fetch("/search-index.json")
      .then((res) => res.json())
      .then((payload) => {
        data = payload;
        if (countNode) {
          countNode.textContent = "索引已加载，可以开始搜索。";
        }
      })
      .catch(() => {
        if (countNode) {
          countNode.textContent = "搜索索引加载失败，请稍后刷新重试。";
        }
      });

    input?.addEventListener("input", handleSearch);
  </script>
</BaseLayout>
