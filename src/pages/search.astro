---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout title="Search" description="Search the journal">
  <div style="max-width: 800px; margin: 0 auto;">
    <h1 class="hero-title" style="font-size: clamp(2.5rem, 5vw, 4rem); margin-bottom: 3rem;">Search.</h1>
    <div style="margin-bottom: 2rem;">
      <input 
        id="search-input" 
        type="search" 
        placeholder="Type to search entries..."
        autocomplete="off"
        style="width: 100%; background: transparent; border: none; border-bottom: 1px solid var(--border); font-size: 1.5rem; font-weight: 300; font-family: inherit; color: var(--text); outline: none; padding: 1rem 0; transition: border-color 0.3s;"
        onfocus="this.style.borderBottomColor='var(--text)'"
        onblur="this.style.borderBottomColor='var(--border)'"
      />
    </div>
    <div id="search-stats" style="font-size: 0.75rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); margin-bottom: 4rem;">
      Preparing index...
    </div>
    <div id="search-results" style="display: flex; flex-direction: column;"></div>
  </div>
  <script is:inline>
    const input = document.getElementById("search-input");
    const resultsNode = document.getElementById("search-results");
    const statsNode = document.getElementById("search-stats");
    let data = [];
    const normalize = (text) => text?.toLowerCase().trim().replace(/\s+/g, " ") || "";
    const render = (items, keyword) => {
      if (!keyword) {
        statsNode.innerHTML = `Index loaded. ${data.length} records.`;
        resultsNode.innerHTML = "";
        return;
      }
      if (items.length === 0) {
        statsNode.innerHTML = `No results.`;
        resultsNode.innerHTML = ``;
        return;
      }
      statsNode.innerHTML = `${items.length} results found.`;
      resultsNode.innerHTML = items
        .map((item) => {
          return `
            <a href="${item.url}" class="list-item-row" style="flex-direction: column; align-items: flex-start; gap: 0.5rem; text-decoration: none; color: inherit;">
              <div style="font-size: 0.7rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted);">
                ${item.category}
              </div>
              <h3 style="font-family: var(--font-serif); font-size: 1.5rem; font-weight: 400; margin: 0; line-height: 1.3;">
                ${item.title}
              </h3>
              <p style="font-size: 0.95rem; line-height: 1.6; color: var(--muted); font-weight: 300; margin: 0.5rem 0 0;">
                ${item.description || item.content.substring(0, 100) + '...'}
              </p>
            </a>
          `;
        })
        .join("");
    };
    const performSearch = (keyword) => {
      const normalizedKeyword = normalize(keyword);
      if (!normalizedKeyword) return render([], "");
      const filtered = data.filter((item) => {
        const searchText = [item.title, item.description, item.category, item.tags.join(" "), item.content].join(" ").toLowerCase();
        return searchText.includes(normalizedKeyword);
      });
      render(filtered, normalizedKeyword);
    };
    let timer;
    input?.addEventListener("input", (e) => {
      clearTimeout(timer);
      timer = setTimeout(() => performSearch(e.target.value), 200);
    });
    fetch("/search-index.json")
      .then((res) => res.json())
      .then((payload) => {
        data = payload;
        statsNode.innerHTML = `Index loaded. ${data.length} records.`;
        const query = new URLSearchParams(window.location.search).get('q');
        if (query) {
          input.value = query;
          performSearch(query);
        }
      })
      .catch(() => {
        statsNode.innerHTML = `Error loading index.`;
      });
  </script>
</BaseLayout>