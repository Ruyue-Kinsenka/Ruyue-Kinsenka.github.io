---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import { getPublishedPosts } from "@/utils/posts";
const posts = await getPublishedPosts();
---
<BaseLayout title="Archive" description="All journal entries">
  <div style="margin-bottom: 5rem;">
    <h1 class="hero-title" style="font-size: clamp(2.5rem, 5vw, 4rem);">The Archive.</h1>
    <p style="color: var(--muted); font-size: 1.1rem; font-weight: 300;">My Life and My Life.</p>
  </div>
  <section>
    {
      posts.length === 0 ? (
        <div style="padding: 4rem 0; color: var(--muted); font-size: 0.85rem; text-transform: uppercase;">Empty archive</div>
      ) : (
        <div class="grid-standard">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      )
    }
  </section>
</BaseLayout>