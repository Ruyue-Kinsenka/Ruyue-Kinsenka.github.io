---
import { render } from "astro:content";
import ArticleEngagement from "@/components/ArticleEngagement.astro";
import PostMeta from "@/components/PostMeta.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPostUrl, getPublishedPosts } from "@/utils/posts";
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: {
      id: post.id
    },
    props: {
      post
    }
  }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const urlPath = getPostUrl(post);
---
<BaseLayout title={`${post.data.title} · Ruyue`} description={post.data.description}>
  <header class="article-header">
    <PostMeta post={post} />
    <h1 class="article-title">{post.data.title}</h1>
    <p style="font-size: 1.1rem; color: var(--muted); font-weight: 300;">{post.data.description}</p>
  </header>
  {
    post.data.cover && (
      <div class="article-hero-wrap">
        <img src={post.data.cover} alt={post.data.coverAlt ?? post.data.title} class="article-hero-image" />
      </div>
    )
  }
  <article class="prose">
    <Content />
    <div style="margin-top: 6rem;">
      <ArticleEngagement path={urlPath} title={post.data.title} />
    </div>
  </article>
</BaseLayout>