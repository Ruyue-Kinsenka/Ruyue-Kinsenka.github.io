---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import { getPublishedPosts } from "@/utils/posts";
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: {
      tag: tag
    },
    props: {
      tag
    }
  }));
}
const { tag } = Astro.props;
const posts = (await getPublishedPosts()).filter((post) => post.data.tags.includes(tag));
---
<BaseLayout title={tag} description={`Tag: ${tag}`}>
  <div style="margin-bottom: 5rem;">
    <span class="section-heading" style="border: none; padding: 0; margin-bottom: 1rem; display: block;">Index</span>
    <h1 class="hero-title" style="font-size: clamp(2.5rem, 5vw, 4rem); margin: 0;">{tag}.</h1>
  </div>
  <div class="grid-standard">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>