---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import { getPublishedPosts } from "@/utils/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return tags.map((tag) => ({
    params: {
      tag: encodeURIComponent(tag)
    },
    props: {
      tag
    }
  }));
}

const { tag } = Astro.props;
const posts = (await getPublishedPosts()).filter((post) => post.data.tags.includes(tag));
---

<BaseLayout title={`#${tag} · 标签`} description={`查看标签 ${tag} 下的文章`}>
  <section>
    <h1 class="page-title">标签：#{tag}</h1>
    <p class="page-subtitle">共 {posts.length} 篇文章。</p>

    {
      posts.length === 0 ? (
        <article class="panel">
          <p class="muted">该标签下暂时没有文章。</p>
        </article>
      ) : (
        <div class="grid post-grid">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      )
    }
  </section>
</BaseLayout>
