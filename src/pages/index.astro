---
import Hero from "@/components/Hero.astro";
import PostCard from "@/components/PostCard.astro";
import TagCloud from "@/components/TagCloud.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE } from "@/config/site";
import { getCategorySummary, getPublishedPosts, getTagSummary } from "@/utils/posts";

const posts = await getPublishedPosts();
const latest = posts.slice(0, 9);
const categories = await getCategorySummary();
const tags = await getTagSummary();
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <Hero />

  <section>
    <h2 class="page-title">最新文章</h2>
    <p class="page-subtitle">共 {posts.length} 篇，按发布时间倒序展示。</p>

    {
      latest.length === 0 ? (
        <article class="panel">
          <p class="muted">还没有发布文章。你可以在 /admin 页面创建第一篇内容。</p>
        </article>
      ) : (
        <div class="grid post-grid">
          {latest.map((post) => <PostCard post={post} />)}
        </div>
      )
    }
  </section>

  <section class="grid" style="margin-top: 1.5rem; grid-template-columns: 1fr 1fr;">
    <article class="panel">
      <h2>分类导航</h2>
      {
        categories.length === 0 ? (
          <p class="muted">暂无分类。</p>
        ) : (
          <ul class="muted">
            {
              categories.map((item) => (
                <li>
                  <a href={`/categories/${encodeURIComponent(item.name)}/`}>
                    {item.name} ({item.count})
                  </a>
                </li>
              ))
            }
          </ul>
        )
      }
      <a class="btn btn-secondary" href="/categories/">查看全部分类</a>
    </article>

    <TagCloud tags={tags.slice(0, 20)} />
  </section>
</BaseLayout>
