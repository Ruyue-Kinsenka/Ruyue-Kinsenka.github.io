---
import PostCard from "@/components/PostCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE } from "@/config/site";
import { getPublishedPosts } from "@/utils/posts";
const posts = await getPublishedPosts();
const latest = posts.slice(0, 6);
---
<BaseLayout title={SITE.title} description={SITE.description}>
  <div class="hero-section">
    <h1 class="hero-title">
      Miko‘s blog,
    </h1>
    <h1 class="hero-title">
      Write down my <span class="highlight-neon"><i>life</i></span> and my notes.
    </h1>
    <p class="hero-subtitle">
      The sea I hang upside down will be your sky.
    </p>
  </div>
  <section>
    <h2 class="section-heading">Selected Journal</h2>
    {
      latest.length === 0 ? (
        <div style="padding: 4rem 0; color: var(--muted); font-size: 0.85rem; text-transform: uppercase;">No entries yet.</div>
      ) : (
        <div class="grid-standard">
          {latest.map((post) => <PostCard post={post} />)}
        </div>
      )
    }
  </section>
  {
    posts.length > 6 && (
      <div style="text-align: center; margin-top: 6rem;">
        <a href="/posts/" class="btn-elegant">View Full Archive</a>
      </div>
    )
  }
</BaseLayout>