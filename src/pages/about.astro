---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE } from "@/config/site";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts"))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);

const lastLogin = new Date().toLocaleString("en-US", {
  weekday: "short",
  month: "short",
  day: "2-digit",
  hour: "2-digit",
  minute: "2-digit",
  second: "2-digit",
  year: "numeric"
});
---

<BaseLayout title={`About - ${SITE.title}`} description={`About ${SITE.author} - a pseudo-terminal profile.`}>
  <div class="terminal-page" id="terminal-page">
    <div class="terminal-window" id="terminal-window">
      <div class="terminal-header">
        <span class="terminal-dot dot-red"></span>
        <span class="terminal-dot dot-yellow"></span>
        <span class="terminal-dot dot-green"></span>
        <span class="terminal-title">shell</span>
      </div>
      <div class="terminal-body">
        <!-- Login sequence -->
        <div class="terminal-line">
          <span class="term-cyan">login as:</span>
          <span class="term-white">miko</span>
        </div>
        <div class="terminal-line">
          <span class="term-cyan">miko@ruyue password:</span>
        </div>
        <div class="terminal-line term-muted">
          Last login: {lastLogin} from 127.0.0.1
        </div>
      <div class="terminal-line">
        <span class="term-green">miko@ruyue:~$</span>
        <span class="term-white">neofetch</span>
      </div>

      <!-- Static neofetch output -->
      <div class="neofetch-output" id="neofetch-output">
        <div class="ascii-art">
          <img src="/ikachan.svg" alt="ikachan" class="ikachan-art" />
        </div>
        <div class="system-info">
          <div class="info-host">
            <span class="term-pink">miko@ruyue</span>
          </div>
          <div class="info-separator">------------------------</div>

          <div class="info-section">
            <span class="term-yellow">Name &gt;</span>
            <span class="term-white">Miko (Ruyue)</span>
          </div>
          <div class="info-section">
            <span class="term-yellow">Blog &gt;</span>
            <a href="/" class="term-link">ruyue-kinsenka.github.io</a>
          </div>

          <div class="info-section">
            <span class="term-yellow">Contact Me &gt;</span>
          </div>
          <div class="info-sub">
            <span class="term-cyan">GitHub:</span>
            <a href="https://github.com/Ruyue-kinsenka" target="_blank" rel="noopener" class="term-link">github.com/Ruyue-kinsenka</a>
          </div>
          <div class="info-sub">
            <span class="term-cyan">E-mail:</span>
            <a href="mailto:ruyueee@outlook.com" class="term-link">ruyueee@outlook.com</a>
          </div>

          <div class="info-section">
            <span class="term-yellow">Skills &gt;</span>
          </div>
          <div class="info-sub">
            <span class="term-cyan">Programs:</span>
            <span class="term-white">Java, Kotlin, HTML5 & CSS, C Series, Python 2 & 3</span>
          </div>
          <div class="info-sub">
            <span class="term-cyan">Languages:</span>
            <span class="term-white">Chinese, English</span>
          </div>

          <div class="info-section">
            <span class="term-yellow">Recent Works &gt;</span>
          </div>
          <div class="info-works">
            {posts.map((post) => (
              <a href={`/posts/${post.id}/`} class="term-link work-link">{post.data.title}</a>
            ))}
            <a href="/posts/" class="term-link work-link">View all posts →</a>
          </div>
        </div>
      </div>

      <div class="terminal-line">
        <span class="term-green">miko@ruyue:~$</span>
        <span class="term-white">exit</span>
      </div>
      <div class="terminal-line term-muted">
        logout
      </div>
      <div class="terminal-line term-muted">
        Connection closed by remote host.
      </div>

      <!-- Dynamic output container -->
      <div id="dynamic-output"></div>

      <!-- Interactive prompt -->
      <div class="terminal-line prompt-line">
        <span class="term-green">miko@ruyue:~$</span>
        <span class="typed-command" id="typed-command"></span>
        <span class="cursor" id="cursor">_</span>
      </div>
      </div>
    </div>

    <input
      type="text"
      class="terminal-input"
      id="terminal-input"
      autocomplete="off"
      autocorrect="off"
      autocapitalize="off"
      spellcheck="false"
      aria-label="Terminal input"
    />

    <div class="terminal-hint" id="terminal-hint">
      Type <span class="term-yellow">help</span> and press Enter. Try <span class="term-yellow">neofetch</span>, <span class="term-yellow">friends</span>, or <span class="term-yellow">date</span>.
    </div>
  </div>

  <script is:inline>
    (function () {
      const terminalPage = document.getElementById('terminal-page');
      const terminalWindow = document.getElementById('terminal-window');
      const input = document.getElementById('terminal-input');
      const typed = document.getElementById('typed-command');
      const cursor = document.getElementById('cursor');
      const output = document.getElementById('dynamic-output');
      const hint = document.getElementById('terminal-hint');

      const COMMANDS = {
        help: {
          desc: 'show available commands',
          run: () => `
            <div class="term-output-block">
              <div class="term-white">Available commands:</div>
              <div class="term-grid">
                <div class="term-row"><span class="term-cyan">about</span><span class="term-muted">${COMMANDS.about.desc}</span></div>
                <div class="term-row"><span class="term-cyan">links</span><span class="term-muted">${COMMANDS.links.desc}</span></div>
                <div class="term-row"><span class="term-cyan">friends</span><span class="term-muted">${COMMANDS.friends.desc}</span></div>
                <div class="term-row"><span class="term-cyan">neofetch</span><span class="term-muted">${COMMANDS.neofetch.desc}</span></div>
                <div class="term-row"><span class="term-cyan">date</span><span class="term-muted">${COMMANDS.date.desc}</span></div>
                <div class="term-row"><span class="term-cyan">whoami</span><span class="term-muted">${COMMANDS.whoami.desc}</span></div>
                <div class="term-row"><span class="term-cyan">echo</span><span class="term-muted">${COMMANDS.echo.desc}</span></div>
                <div class="term-row"><span class="term-cyan">clear</span><span class="term-muted">${COMMANDS.clear.desc}</span></div>
                <div class="term-row"><span class="term-cyan">exit</span><span class="term-muted">${COMMANDS.exit.desc}</span></div>
              </div>
              <div class="term-muted">Tip: use ↑ / ↓ to browse command history, Tab to autocomplete.</div>
            </div>
          `
        },
        about: {
          desc: 'show a short bio',
          run: () => `
            <div class="term-output-block">
              <div class="term-white">Nice to see u again :3</div>
              <div class="term-muted">我想在这里分享我的日常，同时也为了满足某个超级无敌可爱家伙的探索欲～</div>
              <div class="term-muted">今天你又遇到了谁，谁又错过了你呢</div>
            </div>
          `
        },
        links: {
          desc: 'show contact links',
          run: () => `
            <div class="term-output-block">
              <div class="term-white">You found me:</div>
              <div><span class="term-cyan">Blog:</span> <a href="/" class="term-link">ruyue-kinsenka.github.io</a></div>
              <div><span class="term-cyan">GitHub:</span> <a href="https://github.com/Ruyue-kinsenka" target="_blank" rel="noopener" class="term-link">github.com/Ruyue-kinsenka</a></div>
              <div><span class="term-cyan">Email:</span> <a href="mailto:ruyueee@outlook.com" class="term-link">ruyueee@outlook.com</a></div>
            </div>
          `
        },
        friends: {
          desc: 'jump to friends page',
          run: () => {
            setTimeout(() => window.location.href = '/friends/', 600);
            return '<div class="term-output-block term-muted">Redirecting to /friends/ ...</div>';
          }
        },
        neofetch: {
          desc: 'show profile card again',
          run: () => {
            const el = document.getElementById('neofetch-output');
            if (el) {
              el.scrollIntoView({ behavior: 'smooth', block: 'center' });
              el.classList.add('pulse-glow');
              setTimeout(() => el.classList.remove('pulse-glow'), 1200);
            }
            return '<div class="term-output-block term-muted">Profile card highlighted above ↑</div>';
          }
        },
        date: {
          desc: 'show current date and time',
          run: () => `<div class="term-output-block term-white">${new Date().toString()}</div>`
        },
        whoami: {
          desc: 'show current user',
          run: () => '<div class="term-output-block term-white">guest</div>'
        },
        echo: {
          desc: 'echo your text back',
          run: (args) => `<div class="term-output-block term-white">${escapeHtml(args.join(' ') || '')}</div>`
        },
        clear: {
          desc: 'clear dynamic output',
          run: () => {
            if (output) output.innerHTML = '';
            return '';
          }
        },
        exit: {
          desc: 'close the session',
          run: () => {
            setTimeout(() => {
              const goodbye = document.createElement('div');
              goodbye.className = 'terminal-line term-muted';
              goodbye.textContent = 'bye bye ~';
              terminalWindow.appendChild(goodbye);
              terminalWindow.scrollTop = terminalWindow.scrollHeight;
            }, 300);
            return '<div class="term-output-block term-muted">logout</div>';
          }
        }
      };

      const ALIASES = {
        ls: 'help',
        cat: 'about',
        me: 'about',
        contact: 'links'
      };

      let history = [];
      let historyIndex = -1;
      let currentValue = '';

      function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      }

      function renderPrompt(value) {
        if (typed) typed.textContent = value;
      }

      function appendLine(html) {
        const line = document.createElement('div');
        line.className = 'terminal-line';
        line.innerHTML = html;
        output.appendChild(line);
      }

      function execute(raw) {
        const trimmed = raw.trim();
        if (!trimmed) return;

        history.push(trimmed);
        historyIndex = history.length;

        const parts = trimmed.split(/\s+/);
        const cmdName = parts[0].toLowerCase();
        const args = parts.slice(1);

        const resolved = ALIASES[cmdName] || cmdName;
        const command = COMMANDS[resolved];

        appendLine(`<span class="term-green">miko@ruyue:~$</span> <span class="term-white">${escapeHtml(trimmed)}</span>`);

        let result = '';
        if (command) {
          result = command.run(args);
        } else {
          result = `<div class="term-output-block"><span class="term-pink">${escapeHtml(cmdName)}:</span> <span class="term-white">command not found</span><div class="term-muted">Type 'help' for a list of commands.</div></div>`;
        }

        if (result) {
          const res = document.createElement('div');
          res.className = 'terminal-line';
          res.innerHTML = result;
          output.appendChild(res);
        }

        scrollToBottom();
      }

      function scrollToBottom() {
        terminalWindow.scrollTop = terminalWindow.scrollHeight;
        terminalPage.scrollTop = terminalPage.scrollHeight;
      }

      function autocomplete() {
        const value = input.value.toLowerCase();
        if (!value) return;
        const matches = Object.keys(COMMANDS).filter(c => c.startsWith(value));
        if (matches.length === 1) {
          input.value = matches[0];
          renderPrompt(matches[0]);
        } else if (matches.length > 1) {
          appendLine(`<span class="term-green">miko@ruyue:~$</span> <span class="term-white">${escapeHtml(value)}</span>`);
          const res = document.createElement('div');
          res.className = 'terminal-line';
          res.innerHTML = `<div class="term-output-block"><span class="term-muted">${matches.join('  ')}</span></div>`;
          output.appendChild(res);
          scrollToBottom();
        }
      }

      if (input) {
        input.addEventListener('input', (e) => {
          renderPrompt(e.target.value);
          if (hint) hint.style.opacity = e.target.value ? '0' : '1';
        });

        input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            execute(input.value);
            input.value = '';
            renderPrompt('');
            if (hint) hint.style.opacity = '1';
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            if (historyIndex > 0) {
              if (historyIndex === history.length) currentValue = input.value;
              historyIndex--;
              input.value = history[historyIndex];
              renderPrompt(input.value);
            }
          } else if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (historyIndex < history.length - 1) {
              historyIndex++;
              input.value = history[historyIndex];
              renderPrompt(input.value);
            } else if (historyIndex === history.length - 1) {
              historyIndex = history.length;
              input.value = currentValue;
              renderPrompt(currentValue);
            }
          } else if (e.key === 'Tab') {
            e.preventDefault();
            autocomplete();
          }
        });
      }

      terminalPage.addEventListener('click', () => {
        input.focus();
      });

      // Cursor blink
      setInterval(() => {
        if (cursor) cursor.style.opacity = cursor.style.opacity === '0' ? '1' : '0';
      }, 530);

      // Focus input on load
      setTimeout(() => input.focus(), 300);
    })();
  </script>

  <style is:global>
    .terminal-page {
      min-height: calc(100vh - 200px);
      padding: 1rem 0 2rem;
      background: transparent;
      color: var(--text);
      font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', 'SF Mono', Consolas, monospace;
      position: relative;
      cursor: text;
    }

    .terminal-page *:focus {
      outline: none;
    }

    .terminal-window {
      width: 1200px;
      max-width: calc(100vw - 2rem);
      margin: 0 auto;
      font-size: clamp(0.8rem, 1.1vw, 0.95rem);
      line-height: 1.35;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: 0 18px 50px rgba(0, 0, 0, 0.12), 0 4px 12px rgba(0, 0, 0, 0.06);
      overflow: hidden;
    }

    .terminal-header {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.85rem 1.1rem;
      background: rgba(0, 0, 0, 0.03);
      border-bottom: 1px solid var(--border);
    }

    .terminal-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      box-shadow: inset 0 0 0 0.5px rgba(0, 0, 0, 0.12);
    }

    .dot-red { background: #ff5f56; }
    .dot-yellow { background: #ffbd2e; }
    .dot-green { background: #27c93f; }

    .terminal-title {
      margin-left: 0.6rem;
      font-size: 0.8em;
      color: var(--muted);
      font-weight: 500;
      user-select: none;
    }

    .terminal-body {
      padding: 1.25rem 1.5rem 1.5rem 1.1rem;
      overflow-y: auto;
      overflow-x: hidden;
      max-height: calc(100vh - 260px);
    }

    .terminal-line {
      word-break: break-word;
      margin-bottom: 0.15rem;
    }



    .term-cyan { color: #15803d; }
    .term-green { color: #15803d; }
    .term-pink { color: #db2777; }
    .term-yellow { color: #a16207; }
    .term-white { color: var(--text); }
    .term-muted { color: var(--muted); }

    .term-link {
      color: #2563eb;
      text-decoration: underline;
      text-underline-offset: 3px;
      transition: color 0.2s ease;
    }
    .term-link:hover {
      color: #db2777;
    }

    .neofetch-output {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 3rem;
      align-items: start;
      margin: 1rem 0 1.5rem;
      padding: 0;
      background: transparent;
      border-radius: 0;
    }

    .neofetch-output.pulse-glow {
      box-shadow: 0 0 24px rgba(255, 182, 193, 0.45);
    }

    .ascii-art {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .ikachan-art {
      width: 360px;
      max-width: 45vw;
      height: auto;
      filter: drop-shadow(0 4px 10px rgba(15, 23, 42, 0.12));
    }

    .system-info {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .info-host {
      font-weight: 700;
      font-size: 1.05em;
      margin-bottom: 0.1rem;
    }

    .info-separator {
      color: #94a3b8;
      margin-bottom: 0.5rem;
    }

    .info-section {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-top: 0.4rem;
    }

    .info-sub {
      padding-left: 1rem;
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .info-works {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      padding-left: 1rem;
    }

    .work-link {
      display: block;
    }

    .prompt-line {
      margin-top: 0.5rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .typed-command {
      color: var(--text);
      min-width: 1ch;
    }

    .cursor {
      color: #db2777;
      font-weight: 700;
      animation: none;
    }

    .terminal-input {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 1px;
      height: 1px;
      opacity: 0;
      pointer-events: auto;
      border: none;
      outline: none;
      background: transparent;
    }

    .terminal-hint {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      padding: 0.6rem 1rem;
      background: color-mix(in srgb, var(--surface) 75%, transparent);
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--muted);
      font-size: 0.75rem;
      transition: opacity 0.3s ease;
      z-index: 20;
      font-family: 'JetBrains Mono', 'Fira Code', Consolas, monospace;
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
    }

    .term-output-block {
      padding: 0.5rem 0;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      white-space: normal;
    }

    .term-grid {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      padding: 0.5rem 0;
      white-space: normal;
    }

    .term-row {
      display: flex;
      gap: 1rem;
      align-items: baseline;
    }

    .term-row .term-cyan {
      min-width: 6.5ch;
    }

    @media (max-width: 860px) {
      .neofetch-output {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }
      .ascii-art {
        justify-content: flex-start;
      }
      .ikachan-art {
        width: 260px;
        max-width: 55vw;
      }
      .terminal-body {
        padding: 1rem 1rem 1rem 0.85rem;
      }
      .terminal-page {
        padding: 1rem 0 4rem;
      }
      .terminal-hint {
        left: 1rem;
        right: 1rem;
        bottom: 1rem;
        text-align: center;
      }
    }
  </style>
</BaseLayout>
