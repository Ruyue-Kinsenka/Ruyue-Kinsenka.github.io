---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import { getPublishedPosts } from "@/utils/posts";
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const categories = [...new Set(posts.map((post) => post.data.category))];
  return categories.map((category) => ({
    params: {
      category: category
    },
    props: {
      category
    }
  }));
}
const { category } = Astro.props;
const posts = (await getPublishedPosts()).filter((post) => post.data.category === category);
---
<BaseLayout title={category} description={`Category: ${category}`}>
  <div style="margin-bottom: 5rem;">
    <span class="section-heading" style="border: none; padding: 0; margin-bottom: 1rem; display: block;">Directory</span>
    <h1 class="hero-title" style="font-size: clamp(2.5rem, 5vw, 4rem); margin: 0;">{category}.</h1>
  </div>
  <div class="grid-standard">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>