---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import { getPublishedPosts } from "@/utils/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const categories = [...new Set(posts.map((post) => post.data.category))];

  return categories.map((category) => ({
    params: {
      category: encodeURIComponent(category)
    },
    props: {
      category
    }
  }));
}

const { category } = Astro.props;
const posts = (await getPublishedPosts()).filter((post) => post.data.category === category);
---

<BaseLayout title={`${category} · 分类`} description={`查看 ${category} 分类下的文章`}>
  <section>
    <h1 class="page-title">分类：{category}</h1>
    <p class="page-subtitle">共 {posts.length} 篇文章。</p>

    {
      posts.length === 0 ? (
        <article class="panel">
          <p class="muted">该分类下暂时没有文章。</p>
        </article>
      ) : (
        <div class="grid post-grid">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      )
    }
  </section>
</BaseLayout>
