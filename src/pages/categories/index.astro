---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCategorySummary } from "@/utils/posts";
const categories = await getCategorySummary();
---
<BaseLayout title="Directories" description="Journal categories">
  <div style="margin-bottom: 5rem;">
    <h1 class="hero-title" style="font-size: clamp(2.5rem, 5vw, 4rem);">Directories.</h1>
    <p style="color: var(--muted); font-size: 1.1rem; font-weight: 300;">Explorations organized by topic.</p>
  </div>
  <div>
    {
      categories.length === 0 ? (
        <p style="color: var(--muted); font-size: 0.85rem; text-transform: uppercase;">No categories found.</p>
      ) : (
        <div style="display: flex; flex-direction: column;">
          {
            categories.map((item) => (
              <a href={`/categories/${encodeURIComponent(item.name)}/`} class="list-item-row">
                <h3 class="list-item-title">{item.name}</h3>
                <span class="list-item-meta">{item.count} Entries</span>
              </a>
            ))
          }
        </div>
      )
    }
  </div>
</BaseLayout>