---
interface TagItem {
  name: string;
  count: number;
}

interface Props {
  tags: TagItem[];
}

const { tags } = Astro.props;
---

<section class="tag-cloud">
  <h2>标签云</h2>
  {
    tags.length === 0 ? (
      <p class="muted">暂无标签。</p>
    ) : (
      <div class="tag-cloud-list">
        {
          tags.map((tag) => (
            <a class="tag-pill" href={`/tags/${encodeURIComponent(tag.name)}/`}>
              #{tag.name} ({tag.count})
            </a>
          ))
        }
      </div>
    )
  }
</section>
