---
interface TagItem {
  name: string;
  count: number;
}
interface Props {
  tags: TagItem[];
}
const { tags } = Astro.props;
---
<div style="display: flex; flex-wrap: wrap; gap: 0.8rem;">
  {
    tags.length === 0 ? (
      <span style="font-size: 0.75rem; color: var(--muted); text-transform: uppercase;">No Tags</span>
    ) : (
      tags.map((tag) => (
        <a href={`/tags/${encodeURIComponent(tag.name)}/`} class="tag-pill">
          {tag.name} <span style="opacity: 0.5; margin-left: 0.3rem;">{tag.count}</span>
        </a>
      ))
    )
  }
</div>