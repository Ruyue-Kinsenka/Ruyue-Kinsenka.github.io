---
import { WALINE } from "@/config/site";

interface Props {
  path: string;
  title: string;
}

const { path, title } = Astro.props;
const enabled = Boolean(WALINE.serverURL);
---

<section class="panel" aria-label="评论区">
  <h2>评论</h2>
  {
    enabled ? (
      <div
        id="waline"
        data-path={path}
        data-title={title}
        data-server-url={WALINE.serverURL}
      ></div>
    ) : (
      <p class="muted">
        尚未启用评论服务。请在 <code>.env</code> 中配置 <code>PUBLIC_WALINE_SERVER_URL</code> 并部署 Waline 服务。
      </p>
    )
  }
</section>

{
  enabled && (
    <script>
      import { init } from "@waline/client";
      import "@waline/client/style";

      const target = document.getElementById("waline");
      if (target instanceof HTMLElement) {
        const serverURL = target.dataset.serverUrl ?? "";
        const targetPath = target.dataset.path ?? location.pathname;

        init({
          el: target,
          serverURL,
          path: targetPath,
          meta: ["nick", "mail", "link"],
          pageview: true,
          lang: "zh-CN",
          requiredMeta: ["nick"],
          wordLimit: 300,
          login: "enable",
          dark: "body"
        });
      }
    </script>
  )
}
