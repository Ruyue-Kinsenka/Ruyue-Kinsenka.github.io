---
import type { PostEntry } from "@/utils/posts";
import { estimateReadMinutes, formatDate } from "@/utils/posts";
interface Props {
  post: PostEntry;
}
const { post } = Astro.props;
const readingMinutes = estimateReadMinutes(post.body ?? "");
---
<div style="display: flex; justify-content: center; gap: 1.5rem; font-size: 0.7rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted);">
  <span>{formatDate(post.data.publishedAt)}</span>
  <span>—</span>
  <span>{post.data.category}</span>
  <span>—</span>
  <span>{readingMinutes} Min Read</span>
</div>
{
  post.data.tags.length > 0 && (
    <div style="display: flex; justify-content: center; gap: 0.5rem; margin-top: 3rem;">
      {post.data.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`} class="tag-pill">{tag}</a>)}
    </div>
  )
}