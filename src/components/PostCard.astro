---
import type { PostEntry } from "@/utils/posts";
import { formatDate, getPostUrl, summarize } from "@/utils/posts";
interface Props {
  post: PostEntry;
}
const { post } = Astro.props;
const hasCover = post.data.cover;
---
<article class="post-card">
  <div class="post-card-cover-container">
    <a href={getPostUrl(post)} class="post-card-cover-wrap">
      {
        hasCover ? (
          <img src={post.data.cover} alt="" class="post-card-cover" loading="lazy" />
        ) : (
          <div class="post-card-cover"></div>
        )
      }
    </a>
  </div>
  <div class="post-card-meta">
    <span>{post.data.category}</span>
    <span>{formatDate(post.data.publishedAt)}</span>
  </div>
  <h3 class="post-card-title">
    <a href={getPostUrl(post)}>{post.data.title}</a>
  </h3>
  <p class="post-card-desc">
    {post.data.description || summarize(post.body ?? "", 140)}
  </p>
</article>